# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-at-least-32-chars
FLASK_ENV=development
FLASK_DEBUG=true

# ── Storage ───────────────────────────────────────────────────────────────────
# Absolute path to the durable storage directory
SCRAPER_STORAGE_DIR=./storage

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Chromium ──────────────────────────────────────────────────────────────────
# Path to Chromium executable (used by Node.js Playwright engine)
CHROMIUM_EXECUTABLE_PATH=C:\Users\YOUR_NAME\AppData\Local\ms-playwright\chromium-1248\chrome-win64\chrome.exe
HEADLESS=true

# ── Scraper engine ────────────────────────────────────────────────────────────
# Internal port for the Node.js scraper worker
SCRAPER_WORKER_PORT=4001
SCRAPER_WORKER_TOKEN=change-this-internal-token

# ── Limits ────────────────────────────────────────────────────────────────────
DEFAULT_DAILY_LIMIT=500
DEFAULT_JOB_LIMIT=100
MAX_CONCURRENT_JOBS=2
REQUEST_DELAY_MS=1500
PAGE_LOAD_TIMEOUT_MS=30000

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# ── AI Agent (LLM Provider) ───────────────────────────────────────────────────
# Pick one provider. If none is set, agent defaults to MockProvider (no API needed).
# LLM_PROVIDER=groq           # auto-detected if GROQ_API_KEY is set

# Groq (fastest, free tier available) — https://console.groq.com
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama3-70b-8192

# OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# Local (Ollama / LM Studio — OpenAI-compatible endpoint)
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3

# ── Neon PostgreSQL ───────────────────────────────────────────────────────────
# Pooled connection string (for app queries). Get from Neon dashboard.
# Never commit the real value — this file is safe to commit with the placeholder.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Unpooled (direct) connection — only needed for migrations and pg_dump
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Active storage backend: 'json' (default) or 'postgres'
# Do NOT change to 'postgres' until migration is verified and you approve cutover
STORAGE_BACKEND=json
